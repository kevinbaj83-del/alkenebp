#floyd-warshall algo
def shortest_path(matrix):
    n = matrix.shape[0]
    for k in range(n):
        for i in range(n):
            for j in range(n):
                matrix[i, j] = sp.Min(matrix[i, j], matrix[i, k] + matrix[k, j])
    return matrix

#weighted weiner index
def wiener(matrix):
    weight = 0
    for i in range(matrix.shape[0]):
        for j in range(matrix.shape[1]):
            weight += matrix[i,j]
    return weight/2

def weight_dictionary(matrices):
    matrix_dict = {}
    n = 0
    for matrix in matrices:
        n += 1
        shortest_path(matrix)
        weight = wiener(matrix)
        matrix_dict[n] = weight
    return matrix_dict

