def tuple_list(start, stop, step):
    t_list = []
    for a_v in np.arange(start, stop, step):
        for b_v in np.arange(start, stop, step):
            for c_v in np.arange(start, stop, step):
                t_list.append((
                    float(round(a_v, 1)),
                    float(round(b_v, 1)),
                    float(round(c_v, 1))
                ))
    return t_list

tuples = tuple_list(1, 3, 0.1)

def variable_replacer(weight_dict):
    weight_dict_dict = {}

    for m, t in enumerate(tuples, start=1):
        a_v, b_v, c_v = t
        weight_dict_copy = {}

        for n in weight_dict:
            weight_dict_copy[n] = {
                "bp": bp_list[n - 1],
                "weight": float(weight_dict[n].subs({a: a_v, b: b_v, c: c_v}))
            }

        weight_dict_dict[m] = weight_dict_copy

    return weight_dict_dict

def array_producer_x(weight_dict):
    x = []
    for n in weight_dict:
        x.append([np.log(float(weight_dict[n]["weight"]))])
    return np.array(x, dtype=float)

def array_producer_y(weight_dict):
    y = []
    for n in weight_dict:
        y.append(weight_dict[n]["bp"])
    return np.array(y, dtype=float)

def regression_analysis(n_y_x_dict):
    R_2_dict = {}

    for m, n in enumerate(n_y_x_dict, start=0):
        x = array_producer_x(n_y_x_dict[n])
        y = array_producer_y(n_y_x_dict[n])

        fit = LinearRegression().fit(x, y)
        R_2 = fit.score(x, y)

        R_2_dict[tuples[m]] = R_2

    return R_2_dict

def best_R_2(R_2_dict):
    b_R_2 = -float("inf")
    b_t = None
    b_m = None

    for m, t in enumerate(R_2_dict, start=1):
        if R_2_dict[t] > b_R_2:
            b_R_2 = R_2_dict[t]
            b_t = t
            b_m = m

    return b_m, b_t, b_R_2

def bp_weight_lister():
    replaced_dict = variable_replacer(weight_dict)
    best_result = best_R_2(regression_analysis(replaced_dict))
    return replaced_dict[best_result[0]]


